{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app5",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c78a7616-2281-459f-8ff5-fd34794be055","database_name": "web-appjh" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ff25fcf2e8774ef482751abd55c0922c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
